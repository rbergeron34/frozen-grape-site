# Resend — powers the contact form and the "notify me" signup.
# Create a key at https://resend.com/api-keys and copy this file to .env.local.

# Required for the contact form to actually send.
RESEND_API_KEY=

# Where contact messages are delivered. Defaults to support@frozengrape.com if unset.
CONTACT_TO_EMAIL=support@frozengrape.com

# Verified sender. Until frozengrape.app is verified in Resend, the test sender
# onboarding@resend.dev works (only delivers to your own account email).
CONTACT_FROM_EMAIL=onboarding@resend.dev

# Required for the "notify me" signup. Create an Audience in Resend and paste its ID.
RESEND_AUDIENCE_ID=
